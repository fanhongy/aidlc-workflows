{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex mint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex dispatch-rules"
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex state-transition-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex reviewer-scope"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex review-freeze"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex plan-approval-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex audit-and-sensors"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex state-sync"
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex runtime-compile"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex validate-state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex log-subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex stop"
          }
        ]
      }
    ]
  }
}
