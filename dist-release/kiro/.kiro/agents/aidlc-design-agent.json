{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "aidlc-design-agent",
  "description": "AI-DLC Design Agent - delegation target for ensemble stages (UX/UI perspective: mockups, personas, user experience).",
  "prompt": "file://aidlc-design-agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "aidlc engine .*",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-design-agent.md",
    "file://.kiro/knowledge/aidlc-design-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "aidlc engine adapter kiro review-freeze",
        "timeout_ms": 15000
      },
      {
        "matcher": "execute_bash",
        "command": "aidlc engine adapter kiro review-freeze",
        "timeout_ms": 15000
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "aidlc engine adapter kiro audit-and-sensors",
        "timeout_ms": 120000
      }
    ]
  }
}
