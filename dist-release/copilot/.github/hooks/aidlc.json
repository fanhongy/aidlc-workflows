{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter session-start",
        "powershell": "aidlc engine hook copilot-adapter session-start",
        "timeoutSec": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter record-human-turn",
        "powershell": "aidlc engine hook copilot-adapter record-human-turn",
        "timeoutSec": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter guard-tool-call",
        "powershell": "aidlc engine hook copilot-adapter guard-tool-call",
        "timeoutSec": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter post-tool",
        "powershell": "aidlc engine hook copilot-adapter post-tool",
        "timeoutSec": 30
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter validate-state",
        "powershell": "aidlc engine hook copilot-adapter validate-state",
        "timeoutSec": 30
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter subagent-start",
        "powershell": "aidlc engine hook copilot-adapter subagent-start",
        "timeoutSec": 30
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter log-subagent",
        "powershell": "aidlc engine hook copilot-adapter log-subagent",
        "timeoutSec": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "aidlc engine hook copilot-adapter continue-workflow",
        "powershell": "aidlc engine hook copilot-adapter continue-workflow",
        "timeoutSec": 60
      }
    ]
  }
}
